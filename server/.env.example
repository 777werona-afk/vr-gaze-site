# Скопируйте в .env: cp .env.example .env
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/tasks

# Итоговый проект: порог «дестабилизация взгляда: да» — RMS в полосе тремора 4-12 Гц, градусы
TREMOR_THRESHOLD_DEG=0.25
# Сессия с долей валидных отсчётов ниже этого процента получает статус «брак»
MIN_VALID_PCT=90
